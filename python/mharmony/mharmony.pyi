    @property
    def current_channel(self) -> str | None: ...
    def push_tokens(
        self, token_ids_delta: Sequence[int], absolute_start: int
    ) -> dict[str, Any]: ...
    def finish(self, absolute_start: int) -> dict[str, Any]: ...

