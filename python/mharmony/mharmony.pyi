from collections.abc import Callable, Mapping, Sequence
from typing import Any, ClassVar

class HarmonyError(RuntimeError): ...

class CanonicalChannel:
    ANALYSIS: ClassVar[CanonicalChannel]
    COMMENTARY: ClassVar[CanonicalChannel]
    FINAL: ClassVar[CanonicalChannel]
    @staticmethod
    def canonical() -> list[CanonicalChannel]: ...
    @property
    def value(self) -> str: ...
    def __str__(self) -> str: ...

class ProcessedImage:
    def __init__(self, data: Any, shape: Sequence[int] | None = ...) -> None: ...
    @property
    def data(self) -> list[float]: ...
    @property
    def shape(self) -> list[int]: ...
    @property
    def numel(self) -> int: ...
    def into_numpy(self) -> Any: ...
    def to_numpy(self) -> Any: ...
    def into_torch(self) -> Any: ...
    def to_torch(self) -> Any: ...

MediaProcessor = Callable[[Any, dict[str, Any]], Any]
MediaValidator = Callable[[dict[str, Any], dict[str, Any]], object]
TimestampProcessor = Callable[[str, str, dict[str, Any]], str]

class PyCompletionStreamParser:
    @property
